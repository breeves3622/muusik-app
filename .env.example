# ==========================================
# Muusik.app Portainer Stack Environment Variables
# ==========================================

# ------------------------------------------
# Discord Integration
# ------------------------------------------
# Obtain from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# ------------------------------------------
# Ports & Domain Configuration
# ------------------------------------------
API_PORT=8800
WEB_PORT=5173

# The public URL where the web dashboard will be accessed (e.g. https://music.yourdomain.com or http://YOUR_SERVER_IP:5173)
FRONTEND_ORIGIN=http://YOUR_SERVER_IP:5173

# ------------------------------------------
# Supabase Integration (Auth & User Database)
# ------------------------------------------
# Create a free project at https://supabase.com
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
PRIVATE_SUPABASE_SERVICE_ROLE=your_supabase_service_role_key

# ------------------------------------------
# Optional Integrations
# ------------------------------------------
TOPGG_TOKEN=
